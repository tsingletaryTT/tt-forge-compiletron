# TT-Forge Compiletron - Minimal Build
# Uses official Tenstorrent Docker image + PyPI packages
#
# Build time: ~5-10 minutes (vs 2-3 hours for full build)
# Image size: ~10-15GB (vs ~30GB for full build)

FROM ghcr.io/tenstorrent/tt-forge-fe-slim:latest

# Install additional Python dependencies
# Note: tt_forge_fe and tt_tvm already installed in base image
RUN pip install --no-cache-dir \
    onnx \
    pytest \
    pyyaml \
    tabulate

# Create app directory
WORKDIR /app

# Copy compiletron application
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt || true

COPY lib/ ./lib/
COPY compiletron.py .
COPY scripts/ ./scripts/
COPY tests/ ./tests/
COPY README.md .

# Make scripts executable
RUN chmod +x scripts/*.sh || true

# Create directories for volumes
RUN mkdir -p /cache /results /models

# Set up entrypoint
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["help"]
