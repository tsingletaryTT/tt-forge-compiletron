# DEPRECATED: This minimal build approach is no longer supported
#
# The minimal build using pre-built tt-forge-slim images encountered
# fundamental issues with single-chip isolation due to topology discovery
# bugs in the bundled tt-metal library.
#
# Current solution: Full source build (see Dockerfile)
# Future plan: Migrate to torch_plugin_tt when stable
#
# See: https://github.com/tenstorrent/tt-forge-compiletron
# Date deprecated: 2026-03-26

# Original approach was:
# FROM ghcr.io/tenstorrent/tt-forge-slim:0.10.0.dev20260323001402
#
# Issues encountered:
# - Topology discovery bug: n_log=1, n_phys=2 mismatch
# - Control plane crashes on chips 1 & 3
# - TT_VISIBLE_DEVICES isolation not working
# - Forge-bundled tt-metal incompatible with single-chip mode
#
# Resolution: Build tt-metal and tt-forge-fe from source to ensure
# compatibility with STRICT mesh graph descriptors and single-chip isolation.
