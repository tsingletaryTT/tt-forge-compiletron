[9.0937, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[54;1H\u001b[1;38;2;253;151;31;48;2;30;30;30mC0\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m \u001b[0m\u001b[38;2;88;209;235;48;2;30;30;30m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m   0%  \u001b[0m\u001b[38;2;152;224;36;48;2;30;30;30m\u27130\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m/\u001b[0m\u001b[38;2;244;0;95;48;2;30;30;30m\u27170\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[38;2;255;215;0;48;2;30;30;30m    0pts\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[38;2;88;209;235;48;2;30;30;30mroberta/sequence_class\u001b[0m\u001b[48;2;30;30;30m                                                                                                                                                   \u001b[0m\r\n\u001b[55;1H\u001b[1;38;2;253;151;31;48;2;30;30;30mC1\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[38;2;158;158;158;48;2;30;30;30m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  waiting...\u001b[0m\u001b[48;2;30;30;30m                                                                                                                                                                                    \u001b[0m\r\n\u001b[56;1H\u001b[1;38;2;253;151;31;48;2;30;30;30mC2\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[38;2;158;158;158;48;2;30;30;30m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591