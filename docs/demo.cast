[73.186, "o", "\u001b[9;1H\u001b[38;2;1;120;212;48;2;39;39;39m\u2502\u001b[0m\u001b[38;2;88;209;235;48;2;39;39;39m\u2502\u001b[0m\u001b[38;2;224;224;224;48;2;39;39;39m \u001b[0m\u001b[38;2;152;224;36;48;2;39;39;39m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[38;2;161;161;161;48;2;39;39;39m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m\u001b[38;2;224;224;224;48;2;39;39;39m  \u001b[0m\u001b[1;38;2;224;224;224;48;2;39;39;39m19%\u001b[0m\u001b[38;2;224;224;224;48;2;39;39;39m                             \u001b[0m\u001b[38;2;224;224;224;48;2;39;39;39m \u001b[0m\u001b[38;2;88;209;235;48;2;39;39;39m\u2502\u001b[0m\u001b[38;2;224;224;224;48;2;39;39;39m                                                                                                \u001b[0m\u001b[9;176H\u001b[7;38;2;0;48;84;48;2;39;39;39m  \u001b[0m\u001b[9;178H\u001b[38;2;1;120;212;48;2;39;39;39m\u2502\u001b[0m\r\n\u001b[10;1H\u001b[38;2;1;120;212;48;2;39;39;39m\u2502\u001b[0m\u001b[38;2;88;209;235;48;2;39;39;39m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\u001b[38;2;224;224;224;48;2;39;39;39m                                                                                                \u001b[0m\u001b[10;176H\u001b[7;38;2;0;48;84;48;2;39;39;39m  \u001b[0m\u001b[10;178H\u001b[38;2;1;120;212;48;2;39;39;39m\u2502\u001b[0m\r\n"]
