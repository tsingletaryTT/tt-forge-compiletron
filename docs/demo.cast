[23.2986, "o", "\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u001b[0m\u001b[38;2;224;224;224;48;2;18;18;18m \u001b[0m\u001b[38;2;255;135;255;48;2;18;18;18m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m\u001b[38;2;224;224;224;48;2;18;18;18m                   \u001b[0m\u001b[38;2;95;175;255;48;2;18;18;18m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m\u001b[38;2;224;224;224;48;2;18;18;18m  \u001b[0m\u001b[38;2;95;175;255;48;2;18;18;18m\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u001b[0m\u001b[38;2;255;135;255;48;2;18;18;18m\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u001b[0m\u001b[38;2;224;224;224;48;2;18;18;18m \u001b[0m\u001b[38;2;255;135;255;48;2;18;18;18m\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m\u001b[38;2;224;224;224;48;2;18;18;18m                                      \u001b[0m\u001b[38;2;255;135;255;48;2;18;18;18m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m\u001b[38;2;224;224;224;48;2;18;18;18m  \u001b[0m\u001b[38;2;95;175;255;48;2;18;18;18m\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u001b[0m\r\n"]
