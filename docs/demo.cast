[123.0966, "o", "\u001b[5;1H\u001b[38;2;1;120;212;48;2;39;39;39m\u2502\u001b[0m\u001b[1;38;2;88;209;235;48;2;39;39;39m\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\u001b[38;2;224;224;224;48;2;39;39;39m                                                                                                                   \u001b[0m\u001b[7;38;2;0;48;84;48;2;39;39;39m  \u001b[0m\u001b[38;2;1;120;212;48;2;39;39;39m\u2502\u001b[0m\r\n\u001b[6;1H\u001b[38;2;1;120;212;48;2;39;39;39m\u2502\u001b[0m\u001b[38;2;224;224;224;48;2;39;39;39m                                                                                                                                                                              \u001b[0m\u001b[7;38;2;0;48;84;48;2;39;39;39m  \u001b[0m\u001b[38;2;1;120;212;48;2;39;39;39m\u2502\u001b[0m\r\n\u001b[7;1H\u001b[38;2;1;120;212;48;2;39;39;39m\u2502\u001b[0m\u001b[38;2;88;209;235;48;2;39;39;39m\u256d\u2500\u001b[0m\u001b[38;2;88;209;235;48;2;39;39;39m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;2;88;209;235;48;2;39;39;39m \u001b[0m\u001b[1;38;2;88;209;235;48;2;39;39;39mTHIS RUN\u001b[0m\u001b[38;2;88;209;235;48;2;39;39;39m \u001b[0m\u001b[38;2;88;209;235;48;2;39;39;39m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;2;88;209;235;48;2;39;39;39m\u2500\u256e\u001b[0m\u001b[38;2;224;224;224;48;2;39;39;39m                            