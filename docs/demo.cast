[69.273, "o", "\u001b[2J\u001b[H\u001b[38;5;87m\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u001b[0m \u001b[38;5;87m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m                                                     \u001b[38;5;87m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m \u001b[38;5;87m\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u001b[0m \u001b[38;5;87m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m                                                     \u001b[38;5;87m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m \u001b[38;5;87m\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2593\u2593\u2593\u001b[0m\r\n\u001b[38;5;87m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m                               \u001b[38;5;87m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m                               \u001b[38;5;87m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2592\u2592\u2592\u2593\u2593\u2593\u2593\u2593\u2592\u2592\u2592\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\