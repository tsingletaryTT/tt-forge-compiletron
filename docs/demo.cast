[123.0766, "o", "\u001b[1;1H\u001b[48;2;36;47;56m \u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m\u2b58\u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m     \u001b[0m\u001b[48;2;36;47;56m \u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m                                                        \u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56mEXPEDITION #023  COMPLETE\u001b[0m\u001b[38;2;160;163;166;48;2;36;47;56m \u2014 \u001b[0m\u001b[38;2;160;163;166;48;2;36;47;56mr=Run Again  q=Quit\u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m                                                         \u001b[0m\u001b[48;2;36;47;56m \u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m\u001b[0m\u001b[48;2;36;47;56m        \u001b[0m\u001b[48;2;36;47;56m \u001b[0m\r\n\u001b[2;1H\u001b[38;2;1;120;212;48;2;39;39;39m\u250c\u001b[0m\u001b[38;2;1;120;212;48;2;39;39;39m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;2;1;120;212;48;2;39;39;39m\u2510\u001b[0m\r\n\u001b[3;1H\u001b[38;2;1;120;212;48;