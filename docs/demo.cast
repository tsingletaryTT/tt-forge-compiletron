[6.7832, "o", "\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m 100%  \u001b[0m\u001b[38;2;152;224;36;48;2;30;30;30m\u27130\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m/\u001b[0m\u001b[38;2;244;0;95;48;2;30;30;30m\u27171\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[38;2;255;215;0;48;2;30;30;30m  -10pts\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[1;38;2;152;224;36;48;2;30;30;30m\u2713 DONE\u001b[0m\u001b[48;2;30;30;30m                                                                                                                                                                   \u001b[0m\r\n\u001b[58;1H\u001b[48;2;36;47;56m                                                                                                                                                                                                                            \u001b[0m\u001b[1;1H"]
[6.8032, "o", "\u001b[1;1H\u001b[48;2;36;47;56m \u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m\u2b58\u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m     \u001b[0m\u001b[48;2;36;47;56m \u001b[0m\u001b[1;9H\u001b[38;2;224;224;224;48;2;36;47;56m                                                                               \u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56mEXPEDITION  Run #038\u001b[0m\u001b[38;2;160;163;166;48;2;36;47;56m \u2014 \u001b[0m\u001b[38;2;160;163;166;48;2;36;47;56m4 chip(s) \u00b7 BLACKHOLE\u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m                                                                               \u001b[0m\u001b[1;211H\u001b[48;2;44;54;63m \u001b[0m\u001b[38;2;197;198;199;48;2;44;54;63m13:08:24\u001b[0m\u001b[48;2;44;54;63m \u001b[0m\r\n\u001b[2;1H\u001b[38;2;1;120;212;48;2;18;18;18m\u250c\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2500\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m \u2694 CHIP 0    The Forge Mage \u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2510\u001b[0m\u001b[2;93H\u001b[38;2;1;120;212;48;2;18;18;18m\u250c\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2500\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m \u2694 CHIP 1    The Iron Scribe \u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2