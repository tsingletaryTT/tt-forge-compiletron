[2.7683, "o", ";30;30;30m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m 100%  \u001b[0m\u001b[38;2;152;224;36;48;2;30;30;30m\u27132\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m/\u001b[0m\u001b[38;2;244;0;95;48;2;30;30;30m\u27170\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[38;2;255;215;0;48;2;30;30;30m  365pts\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[1;38;2;152;224;36;48;2;30;30;30m\u2713 DONE\u001b[0m\u001b[48;2;30;30;30m                                                                                                                                                                   \u001b[0m\r\n\u001b[48;1H\u001b[1;38;2;253;151;31;48;2;30;30;30mC2\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m \u001b[0m\u001b[38;2;152;224;36;48;2;30;30;30m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m 100%  \u001b[0m\u001b[38;2;152;224;36;48;2;30;30;30m\u27131\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m/\u001b[0m\u001b[38;2;244;0;95;48;2;30;30;30m\u27170\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[38;2;255;215;0;48;2;30;30;30m  150pts\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m  \u001b[0m\u001b[1;38;2;152;224;36;48;2;30;30;30m\u2713 DONE\u001b[0m\u001b[48;2;30;30;30m                                                                                                                                                                   \u001b[0m\r\n\u001b[49;1H\u001b[1;38;2;253;151;31;48;2;30;30;30mC3\u001b[0m\u001b[38;2;224;224;224;48;2;30;30;30m \u001b[0m\u001b[38;2;152;224;36;48;2;30;30;30m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001