[2.7883, "o", "\u001b[1;1H\u001b[48;2;36;47;56m \u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m\u2b58\u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m     \u001b[0m\u001b[48;2;36;47;56m \u001b[0m\u001b[1;9H\u001b[38;2;224;224;224;48;2;36;47;56m                                                                               \u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56mEXPEDITION  Run #071\u001b[0m\u001b[38;2;160;163;166;48;2;36;47;56m \u2014 \u001b[0m\u001b[38;2;160;163;166;48;2;36;47;56m4 chip(s) \u00b7 BLACKHOLE\u001b[0m\u001b[38;2;224;224;224;48;2;36;47;56m                                                                               \u001b[0m\u001b[1;211H\u001b[48;2;44;54;63m \u001b[0m\u001b[38;2;197;198;199;48;2;44;54;63m13:49:44\u001b[0m\u001b[48;2;44;54;63m \u001b[0m\r\n"]
[2.8083, "o", "\u001b[2;1H\u001b[38;2;1;120;212;48;2;18;18;18m\u250c\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2500\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m \u2694 CHIP 0    The Forge Mage \u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2510\u001b[0m\u001b[2;93H\u001b[38;2;1;120;212;48;2;18;18;18m\u250c\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2500\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m \u2694 CHIP 1    The Iron Scribe \u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;2;1;120;212;48;2;18;18;18m\u2510\u001b[0m\u001b[2;185H\u001b[38;2;254;166;43;48;2;18;18;18m\u250c\u001b[0m\u001b[38;2;254;166;43;48;2;18;18;18m\u2500\u001b[0m\u001b[38;2;254;166;43;48;2;18;18;18m   HARDWARE  \u001b[0m\u001b[38;2;254;166;43;48;2;18;18;18m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[3;1H\u001b[38;2;1;120;212;48;2;18;18;18m\u2502\u001b[0m\u001b[3;2H\u001b[38;2;224;224;224;48;2;39;39;39m                                                                                          \u001b[0m\u001b[3;92H\u001b[38;2;1;120;212;48;2;18;18;18m\u2502\u001b[0m\u001b[3;93H\u001b[38;2;1;120;212;48;2;18;18;18m\u2502\u00